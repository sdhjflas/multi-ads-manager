# Local single-operator application. Keep every secret on the server.
HOST=127.0.0.1
PORT=4311
DATABASE_PATH=.data/orbit.sqlite

# 32 random bytes encoded as 64 hex characters or base64. Required before
# OAuth or token credentials can be saved. Keep it in the deployment secret
# manager; losing it makes saved connection credentials unreadable.
ORBIT_VAULT_KEY=
# Exact externally registered callback origin, without a path/query/fragment.
# HTTPS is required outside loopback. This local release still refuses network
# deployment until hosted operator authentication is added.
ORBIT_PUBLIC_URL=http://127.0.0.1:4311

# --- AI provider (optional). Claude is preferred when both are set. ---------
ANTHROPIC_API_KEY=
# Defaults to claude-opus-5.
ANTHROPIC_MODEL=
# Legacy alternative: OpenAI Responses API with structured outputs.
OPENAI_API_KEY=
OPENAI_MODEL=
# Maximum paid AI requests per UTC day across all tasks (not a dollar cap).
AI_DAILY_REQUEST_LIMIT=5

# --- Amazon Ads (optional). Without these, connect a simulated account. ------
# Approved Amazon Ads API Login with Amazon application credentials and the
# advertiser's refresh token. SP-API or Advantage credentials are different.
AMAZON_ADS_CLIENT_ID=
AMAZON_ADS_CLIENT_SECRET=
AMAZON_ADS_REFRESH_TOKEN=
# NA, EU, or FE
AMAZON_ADS_REGION=NA
# Keep false until the supervised pilot is approved. Bounded automation on a
# live account requires true; the sandbox ignores this flag.
AMAZON_ADS_WRITES_ENABLED=false

# --- Read-only Shopify connection (optional OAuth application) --------------
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
# Default: read_products,read_inventory,read_orders
SHOPIFY_SCOPES=
# Pin the Admin GraphQL version used by the tested source contract.
SHOPIFY_API_VERSION=2026-07

# --- Read-only Meta Marketing API connection (optional OAuth application) ---
META_APP_ID=
META_APP_SECRET=
# Keep the Graph API version explicit and update it with contract fixtures.
META_GRAPH_API_VERSION=v24.0

# --- Background brain cycle for workspace accounts with automatic sync -------
# Minutes between full cycles. Pending Amazon report jobs are checked every
# minute while enabled; 0 disables both schedulers.
BRAIN_SYNC_INTERVAL_MINUTES=1440

# Minutes between durable connection queue/due-sync checks; 0 disables the
# scheduler. A successful source sync sets its next 24-hour refresh watermark.
CONNECTION_SYNC_INTERVAL_MINUTES=5
