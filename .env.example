# Local single-operator application. No platform mutations are implemented.
HOST=127.0.0.1
PORT=4311
DATABASE_PATH=.data/orbit.sqlite
# Optional AI experiment ideas. Both values must be deliberately configured.
OPENAI_API_KEY=
OPENAI_MODEL=
# Maximum paid AI requests per UTC day; each has a 4,000 output-token ceiling.
AI_DAILY_REQUEST_LIMIT=5
