# Local single-operator application. Keep every secret on the server.
HOST=127.0.0.1
PORT=4311
DATABASE_PATH=.data/orbit.sqlite

# --- AI provider (optional). Claude is preferred when both are set. ---------
ANTHROPIC_API_KEY=
# Defaults to claude-opus-5.
ANTHROPIC_MODEL=
# Legacy alternative: OpenAI Responses API with structured outputs.
OPENAI_API_KEY=
OPENAI_MODEL=
# Maximum paid AI requests per UTC day across all tasks (not a dollar cap).
AI_DAILY_REQUEST_LIMIT=5

# --- Amazon Ads (optional). Without these, connect a simulated account. ------
# Approved Amazon Ads API Login with Amazon application credentials and the
# advertiser's refresh token. SP-API or Advantage credentials are different.
AMAZON_ADS_CLIENT_ID=
AMAZON_ADS_CLIENT_SECRET=
AMAZON_ADS_REFRESH_TOKEN=
# NA, EU, or FE
AMAZON_ADS_REGION=NA
# Keep false until the supervised pilot is approved. Bounded automation on a
# live account requires true; the sandbox ignores this flag.
AMAZON_ADS_WRITES_ENABLED=false

# --- Background brain cycle for workspace accounts with automatic sync -------
# Minutes between full cycles. Pending Amazon report jobs are checked every
# minute while enabled; 0 disables both schedulers.
BRAIN_SYNC_INTERVAL_MINUTES=1440
